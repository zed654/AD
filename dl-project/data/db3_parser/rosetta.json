    "odomgyro": {
      "type": "nav_msgs/msg/Odometry",
      "description": "자차 위치 및 자세 정보",
      "frequency": "100Hz",
      "fields": {
        "_pose": {
          "description": "위치 및 자세",
          "sub_fields": {
            "_pose": {
              "_position": {
                "_x": "전역 X 좌표 (미터)",
                "_y": "전역 Y 좌표 (미터)",
                "_z": "전역 Z 좌표 (미터)"
              },
              "_orientation": {
                "description": "쿼터니언 방향",
